{
  "name": "sim-bk-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for the SIM-BK application running in XAMPP",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "id.simbk.desktop",
    "productName": "SIM-BK",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../favicon.ico",
        "to": "favicon.ico"
      }
    ],
    "win": {
      "icon": "../favicon.ico",
      "target": "portable",
      "artifactName": "SIM-BK.exe"
    }
  }
}
